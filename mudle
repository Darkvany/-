mariadb -e "CREATE DATABASE moodle DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
mariadb -e "CREATE USER 'moodleuser'@'localhost' IDENTIFIED BY 'StrongPass123!';"
mariadb -e "GRANT ALL PRIVILEGES ON moodle.* TO 'moodleuser'@'localhost';"
mariadb -e "FLUSH PRIVILEGES;"

cd /tmp
# Скачиваем Moodle (если прямая ссылка устареет, можно скачать zip с сайта moodle.org)
wget https://download.moodle.org/download.php/direct/stable404/moodle-4.4.tgz
tar -xvzf moodle-4.4.tgz

# Переносим в веб-директорию
mv moodle /var/www/html/

# Создаем папку для данных Moodle (должна быть вне веб-корня)
mkdir /var/www/moodledata

# Назначаем права для веб-сервера
chown -R www-data:www-data /var/www/html/moodle
chown -R www-data:www-data /var/www/moodledata
chmod -R 777 /var/www/moodledata
