cd /tmp
wget https://download.moodle.org/download.php/direct/stable405/moodle-latest-405.tgz
tar -xzf moodle-latest-405.tgz -C /var/www/html/
mv /var/www/html/moodle /var/www/html/moodle-site
mkdir -p /var/www/moodledata
chown -R www-data:www-data /var/www/html/moodle-site /var/www/moodledata
chmod -R 755 /var/www/html/moodle-site
chmod -R 770 /var/www/moodledata
